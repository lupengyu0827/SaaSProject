generator client {
  provider = "prisma-client-js"
  output   = "../apps/core/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["commerce", "platform", "shared"]
}

model Tenant {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                  @db.VarChar(100)
  subdomain              String                  @unique @db.VarChar(50)
  customDomain           String?                 @unique @map("custom_domain") @db.VarChar(100)
  isolationLevel         String                  @default("logical") @map("isolation_level") @db.VarChar(20)
  schemaName             String?                 @unique @map("schema_name") @db.VarChar(50)
  dbConnectionEnc        String?                 @map("db_connection_enc")
  status                 String                  @default("active") @db.VarChar(20)
  planId                 String?                 @map("plan_id") @db.Uuid
  subscriptionId         String?                 @unique @map("subscription_id") @db.Uuid
  expiredAt              DateTime?               @map("expired_at") @db.Timestamptz(6)
  settings               Json                    @default("{}")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan                   Plan?                   @relation(fields: [planId], references: [id])
  currentSubscription    Subscription?           @relation("CurrentSubscription", fields: [subscriptionId], references: [id])
  subscriptions          Subscription[]          @relation("TenantSubscriptions")
  usageMetrics           UsageMetric[]
  invoices               Invoice[]
  adminUsers             AdminUser[]
  customers              Customer[]
  roles                  Role[]
  providerCallbackRoutes ProviderCallbackRoute[]
  mediaUploadSessions    MediaUploadSession[]
  mediaAssets            MediaAsset[]

  @@index([status])
  @@map("tenants")
  @@schema("platform")
}

/// 平台级支付渠道回调路由；在设置租户 RLS 上下文前安全解析资源归属。
model ProviderCallbackRoute {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  channel      String   @db.VarChar(30)
  resourceType String   @map("resource_type") @db.VarChar(30)
  externalNo   String   @map("external_no") @db.VarChar(100)
  resourceId   String   @map("resource_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([channel, resourceType, externalNo])
  @@index([tenantId, resourceType, resourceId])
  @@map("provider_callback_routes")
  @@schema("platform")
}

model Customer {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  wechatOpenId  String                   @map("wechat_open_id") @db.VarChar(64)
  wechatUnionId String?                  @map("wechat_union_id") @db.VarChar(64)
  displayName   String?                  @map("display_name") @db.VarChar(100)
  avatarUrl     String?                  @map("avatar_url") @db.VarChar(500)
  status        String                   @default("active") @db.VarChar(20)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      CustomerRefreshSession[]

  @@unique([tenantId, wechatOpenId])
  @@index([tenantId, status])
  @@map("customers")
  @@schema("platform")
}

model CustomerRefreshSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("customer_refresh_sessions")
  @@schema("platform")
}

model AdminUser {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  email        String           @db.VarChar(200)
  displayName  String           @map("display_name") @db.VarChar(100)
  status       String           @default("active") @db.VarChar(20)
  passwordHash String           @map("password_hash")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  sessions     RefreshSession[]

  @@unique([tenantId, email])
  @@map("admin_users")
  @@schema("platform")
}

model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  actorType String    @default("admin_user") @map("actor_type") @db.VarChar(30)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, actorType, expiresAt])
  @@map("refresh_sessions")
  @@schema("platform")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  code        String           @db.VarChar(50)
  name        String           @db.VarChar(100)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
  @@schema("platform")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
  @@schema("platform")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("platform")
}

model UserRole {
  userId String    @map("user_id") @db.Uuid
  roleId String    @map("role_id") @db.Uuid
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("platform")
}

model Plan {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String         @unique @db.VarChar(50)
  name           String         @db.VarChar(100)
  description    String?
  priceMonthly   Decimal        @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly    Decimal        @default(0) @map("price_yearly") @db.Decimal(10, 2)
  isolationLevel String         @map("isolation_level") @db.VarChar(20)
  trialDays      Int            @default(0) @map("trial_days")
  features       Json
  quotas         Json
  sortOrder      Int            @default(0) @map("sort_order")
  isPublic       Boolean        @default(true) @map("is_public")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenants        Tenant[]
  subscriptions  Subscription[]

  @@map("plans")
  @@schema("platform")
}

model Subscription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  status             String    @default("active") @db.VarChar(20)
  billingCycle       String    @default("monthly") @map("billing_cycle") @db.VarChar(10)
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(6)
  trialEnd           DateTime? @map("trial_end") @db.Timestamptz(6)
  autoRenew          Boolean   @default(true) @map("auto_renew")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant    @relation("TenantSubscriptions", fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan      @relation(fields: [planId], references: [id])
  currentForTenant   Tenant?   @relation("CurrentSubscription")
  invoices           Invoice[]

  @@index([tenantId, currentPeriodEnd])
  @@map("subscriptions")
  @@schema("platform")
}

model UsageMetric {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  metricKey   String   @map("metric_key") @db.VarChar(50)
  amount      BigInt   @default(0)
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricKey, periodStart])
  @@map("usage_metrics")
  @@schema("platform")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  invoiceNo      String        @unique @map("invoice_no") @db.VarChar(32)
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  items          Json
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         String        @default("draft") @db.VarChar(20)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  pdfFileId      String?       @map("pdf_file_id") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
  @@schema("platform")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String?  @map("actor_type") @db.VarChar(20)
  action       String   @db.VarChar(50)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  diff         Json?
  requestId    String?  @map("request_id") @db.VarChar(64)
  ip           String?  @db.Inet
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
  @@schema("shared")
}

model DomainEventOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.VarChar(100)
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([tenantId, publishedAt, occurredAt])
  @@map("domain_event_outbox")
  @@schema("shared")
}

model MediaUploadSession {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  actorId   String      @map("actor_id") @db.Uuid
  purpose   String      @db.VarChar(30)
  objectKey String      @unique @map("object_key") @db.VarChar(300)
  fileName  String      @map("file_name") @db.VarChar(200)
  mimeType  String      @map("mime_type") @db.VarChar(50)
  sizeBytes Int         @map("size_bytes")
  status    String      @default("initiated") @db.VarChar(20)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset     MediaAsset?

  @@index([tenantId, status, expiresAt])
  @@map("media_upload_sessions")
  @@schema("shared")
}

model MediaAsset {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  uploadSessionId String             @unique @map("upload_session_id") @db.Uuid
  createdBy       String             @map("created_by") @db.Uuid
  purpose         String             @db.VarChar(30)
  objectKey       String             @unique @map("object_key") @db.VarChar(300)
  mimeType        String             @map("mime_type") @db.VarChar(50)
  sizeBytes       Int                @map("size_bytes")
  sha256          String             @db.VarChar(64)
  status          String             @default("temporary") @db.VarChar(20)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)
  purgedAt        DateTime?          @map("purged_at") @db.Timestamptz(6)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadSession   MediaUploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Restrict)
  productImage    ProductImage?

  @@index([tenantId, status, createdAt])
  @@index([status, deletedAt, purgedAt])
  @@map("media_assets")
  @@schema("shared")
}

model TenantProbe {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("tenant_probes")
  @@schema("commerce")
}

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(100)
  sortOrder Int        @default(0) @map("sort_order")
  status    String     @default("active") @db.VarChar(20)
  version   Int        @default(0)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@index([tenantId, status, deletedAt])
  @@map("categories")
  @@schema("commerce")
}

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(100)
  logoUrl   String?   @map("logo_url") @db.VarChar(500)
  status    String    @default("active") @db.VarChar(20)
  version   Int       @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId, status, deletedAt])
  @@map("brands")
  @@schema("commerce")
}

model Product {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  categoryId  String?          @map("category_id") @db.Uuid
  brandId     String?          @map("brand_id") @db.Uuid
  code        String           @db.VarChar(50)
  name        String           @db.VarChar(200)
  description String?
  attributes  Json             @default("{}")
  seoSlug     String?          @map("seo_slug") @db.VarChar(200)
  status      String           @default("draft") @db.VarChar(20)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid
  version     Int              @default(0)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  category    Category?        @relation(fields: [categoryId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]

  @@unique([tenantId, code])
  @@unique([tenantId, seoSlug])
  @@index([tenantId, status, deletedAt, createdAt])
  @@map("products")
  @@schema("commerce")
}

model ProductVariant {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  productId             String                 @map("product_id") @db.Uuid
  sku                   String                 @db.VarChar(80)
  specs                 Json                   @default("{}")
  price                 Decimal                @default(0) @db.Decimal(12, 2)
  costPrice             Decimal                @default(0) @map("cost_price") @db.Decimal(12, 2)
  weightG               Decimal?               @map("weight_g") @db.Decimal(10, 2)
  version               Int                    @default(0)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId, deletedAt])
  @@map("product_variants")
  @@schema("commerce")
}

model ProductImage {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  productId    String      @map("product_id") @db.Uuid
  mediaAssetId String?     @unique @map("media_asset_id") @db.Uuid
  url          String      @db.VarChar(1000)
  altText      String?     @map("alt_text") @db.VarChar(200)
  sortOrder    Int         @default(0) @map("sort_order")
  isPrimary    Boolean     @default(false) @map("is_primary")
  sizeBytes    Int         @map("size_bytes")
  mimeType     String      @map("mime_type") @db.VarChar(50)
  version      Int         @default(0)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product     @relation(fields: [productId], references: [id])
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, deletedAt, sortOrder])
  @@map("product_images")
  @@schema("commerce")
}

model Order {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  orderNo            String      @map("order_no") @db.VarChar(40)
  idempotencyKey     String      @map("idempotency_key") @db.VarChar(100)
  requestFingerprint String      @map("request_fingerprint") @db.VarChar(64)
  status             String      @default("pending") @db.VarChar(20)
  customer           Json        @default("{}")
  shippingAddress    Json        @map("shipping_address")
  subtotal           Decimal     @db.Decimal(12, 2)
  discount           Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee        Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  remark             String?     @db.VarChar(500)
  canceledAt         DateTime?   @map("canceled_at") @db.Timestamptz(6)
  canceledBy         String?     @map("canceled_by") @db.Uuid
  cancelReason       String?     @map("cancel_reason") @db.VarChar(200)
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz(6)
  expiredAt          DateTime?   @map("expired_at") @db.Timestamptz(6)
  createdBy          String?     @map("created_by") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  items              OrderItem[]
  payments           Payment[]
  shipments          Shipment[]
  refunds            Refund[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, expiresAt])
  @@map("orders")
  @@schema("commerce")
}

model Payment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  paymentNo       String    @map("payment_no") @db.VarChar(40)
  idempotencyKey  String    @map("idempotency_key") @db.VarChar(100)
  channel         String    @db.VarChar(30)
  status          String    @default("pending") @db.VarChar(20)
  amount          Decimal   @db.Decimal(12, 2)
  providerTradeNo String?   @map("provider_trade_no") @db.VarChar(100)
  callbackEventId String?   @map("callback_event_id") @db.VarChar(100)
  failureReason   String?   @map("failure_reason") @db.VarChar(200)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  order           Order     @relation(fields: [orderId], references: [id])

  @@unique([tenantId, paymentNo])
  @@unique([tenantId, idempotencyKey])
  @@unique([channel, callbackEventId])
  @@index([tenantId, orderId, createdAt])
  @@map("payments")
  @@schema("commerce")
}

model PaymentReconciliationRun {
  id               String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                             @map("tenant_id") @db.Uuid
  channel          String                             @db.VarChar(30)
  billDate         DateTime                           @map("bill_date") @db.Date
  status           String                             @default("processing") @db.VarChar(20)
  localCount       Int                                @default(0) @map("local_count")
  providerCount    Int                                @default(0) @map("provider_count")
  discrepancyCount Int                                @default(0) @map("discrepancy_count")
  errorMessage     String?                            @map("error_message") @db.VarChar(1000)
  completedAt      DateTime?                          @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(6)
  discrepancies    PaymentReconciliationDiscrepancy[]

  @@unique([tenantId, channel, billDate])
  @@index([tenantId, status, billDate])
  @@map("payment_reconciliation_runs")
  @@schema("commerce")
}

model PaymentReconciliationDiscrepancy {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  runId           String                   @map("run_id") @db.Uuid
  paymentNo       String                   @map("payment_no") @db.VarChar(40)
  type            String                   @db.VarChar(40)
  localAmount     Decimal?                 @map("local_amount") @db.Decimal(12, 2)
  providerAmount  Decimal?                 @map("provider_amount") @db.Decimal(12, 2)
  providerTradeNo String?                  @map("provider_trade_no") @db.VarChar(100)
  resolvedAt      DateTime?                @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  run             PaymentReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([tenantId, runId, paymentNo, type])
  @@index([tenantId, type, resolvedAt])
  @@map("payment_reconciliation_discrepancies")
  @@schema("commerce")
}

model OrderItem {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  productName   String         @map("product_name") @db.VarChar(200)
  sku           String         @db.VarChar(80)
  specs         Json           @default("{}")
  unitPrice     Decimal        @map("unit_price") @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal        @map("line_total") @db.Decimal(12, 2)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  shipmentItems ShipmentItem[]
  refundItems   RefundItem[]

  @@unique([tenantId, orderId, variantId])
  @@index([tenantId, orderId])
  @@map("order_items")
  @@schema("commerce")
}

model Shipment {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  shipmentNo  String         @map("shipment_no") @db.VarChar(40)
  carrierCode String         @map("carrier_code") @db.VarChar(40)
  carrierName String         @map("carrier_name") @db.VarChar(80)
  trackingNo  String         @map("tracking_no") @db.VarChar(100)
  status      String         @default("shipped") @db.VarChar(20)
  shippedAt   DateTime       @default(now()) @map("shipped_at") @db.Timestamptz(6)
  deliveredAt DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdBy   String?        @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int            @default(0)
  order       Order          @relation(fields: [orderId], references: [id])
  items       ShipmentItem[]

  @@unique([tenantId, shipmentNo])
  @@unique([tenantId, carrierCode, trackingNo])
  @@index([tenantId, orderId, createdAt])
  @@map("shipments")
  @@schema("commerce")
}

model ShipmentItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  shipmentId  String    @map("shipment_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([tenantId, shipmentId, orderItemId])
  @@index([tenantId, orderItemId])
  @@map("shipment_items")
  @@schema("commerce")
}

model Refund {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  orderId            String              @map("order_id") @db.Uuid
  refundNo           String              @map("refund_no") @db.VarChar(40)
  idempotencyKey     String              @map("idempotency_key") @db.VarChar(100)
  requestFingerprint String              @map("request_fingerprint") @db.VarChar(64)
  status             String              @default("pending_review") @db.VarChar(30)
  reason             String              @db.VarChar(500)
  amount             Decimal             @db.Decimal(12, 2)
  reviewNote         String?             @map("review_note") @db.VarChar(500)
  reviewedBy         String?             @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  createdBy          String?             @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                 @default(0)
  order              Order               @relation(fields: [orderId], references: [id])
  items              RefundItem[]
  transactions       RefundTransaction[]

  @@unique([tenantId, refundNo])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("refunds")
  @@schema("commerce")
}

model RefundItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  refundId    String    @map("refund_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  quantity    Int
  amount      Decimal   @db.Decimal(12, 2)
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([tenantId, refundId, orderItemId])
  @@index([tenantId, orderItemId])
  @@map("refund_items")
  @@schema("commerce")
}

model RefundTransaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  refundId         String   @map("refund_id") @db.Uuid
  channel          String   @db.VarChar(30)
  status           String   @default("pending") @db.VarChar(20)
  amount           Decimal  @db.Decimal(12, 2)
  providerRefundNo String?  @map("provider_refund_no") @db.VarChar(100)
  eventId          String?  @map("event_id") @db.VarChar(100)
  failureReason    String?  @map("failure_reason") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  refund           Refund   @relation(fields: [refundId], references: [id])

  @@unique([tenantId, channel, eventId])
  @@index([tenantId, refundId, createdAt])
  @@map("refund_transactions")
  @@schema("commerce")
}

model InventoryTransaction {
  id            BigInt         @id @default(autoincrement())
  tenantId      String         @map("tenant_id") @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  type          String         @db.VarChar(20)
  qtyChange     Int            @map("qty_change")
  referenceType String         @map("reference_type") @db.VarChar(30)
  referenceId   String         @map("reference_id") @db.VarChar(100)
  reason        String?        @db.VarChar(200)
  operatorId    String?        @map("operator_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([tenantId, variantId, type, referenceType, referenceId])
  @@index([tenantId, variantId, createdAt])
  @@map("inventory_transactions")
  @@schema("commerce")
}

model PaymentWebhookEvent {
  id                 BigInt    @id @default(autoincrement())
  tenantId           String    @map("tenant_id") @db.Uuid
  channel            String    @db.VarChar(30)
  eventId            String    @map("event_id") @db.VarChar(100)
  payloadFingerprint String    @map("payload_fingerprint") @db.VarChar(64)
  payload            Json
  status             String    @default("pending") @db.VarChar(20)
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError          String?   @map("last_error") @db.VarChar(1000)
  processedAt        DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, channel, eventId])
  @@index([tenantId, status, nextAttemptAt])
  @@map("payment_webhook_events")
  @@schema("commerce")
}

model RefundWebhookEvent {
  id                 BigInt    @id @default(autoincrement())
  tenantId           String    @map("tenant_id") @db.Uuid
  channel            String    @db.VarChar(30)
  eventId            String    @map("event_id") @db.VarChar(100)
  payloadFingerprint String    @map("payload_fingerprint") @db.VarChar(64)
  payload            Json
  status             String    @default("pending") @db.VarChar(20)
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError          String?   @map("last_error") @db.VarChar(1000)
  processedAt        DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, channel, eventId])
  @@index([tenantId, status, nextAttemptAt])
  @@map("refund_webhook_events")
  @@schema("commerce")
}
