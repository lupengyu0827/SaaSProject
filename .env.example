NODE_ENV=development
GATEWAY_PORT=3000
CORE_PORT=3001
CORE_BASE_URL=http://localhost:3001
GATEWAY_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=local-internal-key
JWT_ACCESS_SECRET=local-development-secret-change-me-32chars

POSTGRES_DB=saas_platform
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas_local_password
DATABASE_URL=postgresql://saas:saas_local_password@localhost:5432/saas_platform?schema=public
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_EXPIRATION_SCHEDULER_ENABLED=true
ORDER_EXPIRATION_SCAN_INTERVAL_MS=60000
MOCK_PAYMENT_SECRET=local-mock-payment-secret

# WeChat Mini Program login (server-side only, never expose the secret to Vite)
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# WeChat Pay v3 (required only when channel=wechat_pay)
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
PAYMENT_WEBHOOK_WORKER_ENABLED=true
PAYMENT_WEBHOOK_SCAN_INTERVAL_MS=1000
PAYMENT_RECONCILIATION_WORKER_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_PENDING_AGE_MS=60000
PAYMENT_BILL_RECONCILIATION_ENABLED=true

VITE_API_BASE_URL=http://localhost:3000/api
VITE_TENANT_ID=
REFUND_WEBHOOK_WORKER_ENABLED=true
REFUND_WEBHOOK_SCAN_INTERVAL_MS=1000

REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=saas_minio
MINIO_ROOT_PASSWORD=saas_minio_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=saas-local
# local 用于本地开发；测试和生产必须设置为 s3。
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=/absolute/path/to/project/storage/media
# S3/MinIO 生产适配器。未填写专用值时会兼容读取上面的 MINIO_* 配置。
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_BUCKET=saas-local
MEDIA_S3_REGION=us-east-1
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=saas_minio
MEDIA_S3_SECRET_ACCESS_KEY=saas_minio_password
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_MS=3600000
MEDIA_TEMPORARY_RETENTION_HOURS=168
MEDIA_DELETED_RETENTION_HOURS=720
MEDIA_CLEANUP_BATCH_SIZE=100
